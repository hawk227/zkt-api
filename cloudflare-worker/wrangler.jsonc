{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zkteco-attendance-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zkteco-attendance",
      "database_id": "2bcc28fa-6959-488d-a946-e356e485cedc",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "ATTENDANCE_QUEUE", "queue": "zkteco-attendance-events" }],
    "consumers": [{ "queue": "zkteco-attendance-events", "max_batch_size": 50, "max_retries": 3 }]
  },
  "env": {
    "staging": {
      "name": "zkteco-attendance-gateway-staging",
      "d1_databases": [{ "binding": "DB", "database_name": "zkteco-attendance-staging", "database_id": "eff0478e-521a-4f22-98d4-80d97f4fcabd", "migrations_dir": "migrations" }],
      "queues": {
        "producers": [{ "binding": "ATTENDANCE_QUEUE", "queue": "zkteco-attendance-events-staging" }],
        "consumers": [{ "queue": "zkteco-attendance-events-staging", "max_batch_size": 50, "max_retries": 3 }]
      }
    },
    "production": {
      "name": "zkteco-attendance-gateway-production",
      "routes": [{ "pattern": "zkt.astromi.xyz", "custom_domain": true }],
      "d1_databases": [{ "binding": "DB", "database_name": "zkteco-attendance", "database_id": "2bcc28fa-6959-488d-a946-e356e485cedc", "migrations_dir": "migrations" }],
      "queues": {
        "producers": [{ "binding": "ATTENDANCE_QUEUE", "queue": "zkteco-attendance-events" }],
        "consumers": [{ "queue": "zkteco-attendance-events", "max_batch_size": 50, "max_retries": 3 }]
      }
    }
  }
}
